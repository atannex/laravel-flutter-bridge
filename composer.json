{
  "name": "atannex/laravel-flutter-bridge",
  "description": "Enterprise-grade Laravel bridge for Flutter applications: Sanctum auth with rotating refresh tokens, connection sessions & remote sign-out, app keys with version policy, Reverb broadcasting, device registration, and Dart code generation.",
  "keywords": [
    "laravel",
    "flutter",
    "bridge",
    "sanctum",
    "reverb",
    "api",
    "mobile",
    "push-notifications",
    "connections",
    "sessions",
    "heartbeat",
    "refresh-tokens",
    "websockets"
  ],
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Atannex Enterprise"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "illuminate/http": "^12.0|^13.0",
    "illuminate/routing": "^12.0|^13.0",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/console": "^12.0|^13.0",
    "illuminate/broadcasting": "^12.0|^13.0"
  },
  "suggest": {
    "laravel/sanctum": "Required for default mobile token authentication (^3.0|^4.0)",
    "laravel/reverb": "Required for modern WebSockets / real-time broadcasting (^1.0)",
    "laravel/fortify": "Reuse Fortify's sign-in, sign-up and authenticator-app two-step check on the bridge auth endpoints (^1.0)"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11.0|^12.0",
    "laravel/sanctum": "^4.0",
    "larastan/larastan": "^3.0",
    "laravel/fortify": "^1.41",
    "laravel/pint": "^1.27",
    "laravel/passkeys": "^0.2"
  },
  "autoload": {
    "psr-4": {
      "Atannex\\LaravelFlutterBridge\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Atannex\\LaravelFlutterBridge\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Atannex\\LaravelFlutterBridge\\LaravelFlutterBridgeServiceProvider"
      ],
      "aliases": {
        "FlutterBridge": "Atannex\\LaravelFlutterBridge\\Facades\\FlutterBridge"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
